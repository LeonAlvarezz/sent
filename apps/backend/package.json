{
  "name": "sent-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "db:gen": "bun node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply sent-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sent-db --remote",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:remote": "wrangler d1 execute sent-db --remote --file=src/db/seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && bun run db:migrate:local && bun run db:seed"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/bun": "^1.4.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14",
    "tsx": "^4.20.4",
    "typescript": "5.9.2",
    "wrangler": "^4.135.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@better-auth/cli": "^1.3.7",
    "@hono/valibot-validator": "^0.6.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@scalar/express-api-reference": "^0.10.16",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/http-errors": "^2.0.4",
    "@types/method-override": "^3.0.0",
    "@types/qs": "^6.9.18",
    "@z3/types": "workspace:*",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.3.7",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "hono": "^4.13.8",
    "http-errors": "^2.0.0",
    "method-override": "^3.0.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.19.0",
    "pg": "^8.16.3",
    "qs": "^6.14.0",
    "swagger-jsdoc": "^6.3.0",
    "valibot": "^1.4.2",
    "winston": "^3.17.0"
  }
}
