{
  "name": "z3-admin",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mock": "bun --cwd apps/starter dev",
    "dev:backend": "bun --cwd apps/backend dev",
    "dev:frontend": "bun --cwd apps/starter dev",
    "lint": "turbo run lint",
    "test": "bun test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:migrate": "bun --cwd apps/backend db:migrate",
    "db:push": "bun --cwd apps/backend db:push",
    "db:reset": "bun --cwd apps/backend db:reset",
    "db:seed": "bun --cwd apps/backend db:seed",
    "db:gen": "bun --cwd apps/backend db:gen"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.9"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
